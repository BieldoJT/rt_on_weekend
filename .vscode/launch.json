{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug com GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/miniRT", // ou o caminho para seu executável
      "args": ["scenes/billard.rt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb", // ajuste se estiver em outro caminho
      "setupCommands": [
        {
          "description": "Habilita formatação de impressão para GDB",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
